# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Backend saved sessions (ephemeral data – not source code)
backend/storage/*.json

# Node / frontend
frontend/node_modules/
frontend/dist/

# Vite cache
frontend/.vite/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# graphifyy - keep graph outputs (committed for shared context), skip heavy/local-only files
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
# intermediate pipeline working files (not useful to share)
graphify-out/.graphify_*
# legacy paths from earlier approach (no longer used)
backend/kg_output/
backend/knowledge_graph/
backend/*.graphml
backend/*.gexf
backend/*.ttl
backend/*.rdf
backend/*.jsonld

# Local runtime DB
backend/storage/app.db

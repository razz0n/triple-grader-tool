# Backend Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to git

# Supabase Session Pooler Connection String
# Get from: Supabase Dashboard → Database → Connection pooling → Session
DATABASE_URL=postgresql://postgres.XXXXX:%23PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Storage backend (use 'database' for production with Supabase)
STORAGE_BACKEND=database

# CORS Origins (comma-separated URLs allowed to access this API)
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Optional: Sentry for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/yyyy
